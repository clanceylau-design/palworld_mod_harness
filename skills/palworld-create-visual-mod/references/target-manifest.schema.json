{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Palworld 视觉 Mod 目标清单",
  "type": "object",
  "required": ["schemaVersion", "artifactType", "gameBuildId", "parentArtifacts", "source", "resolution", "target", "replacement", "assets", "readiness", "warnings", "contentSha256"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "artifactType": { "const": "TargetManifest" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "gameBuildId": { "type": "string", "minLength": 1 },
    "parentArtifacts": { "type": "object" },
    "source": { "type": "object" },
    "resolution": {
      "type": "object",
      "required": ["method", "confidence", "query"],
      "properties": {
        "method": { "const": "exact" },
        "confidence": { "const": 1.0 },
        "query": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "target": { "type": "object", "required": ["palId", "assetRoot"] },
    "replacement": {
      "type": "object",
      "required": ["mode", "rationale"],
      "properties": {
        "mode": { "enum": ["texture_only", "constrained_mesh", "same_skeleton_mesh"] },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "required": ["primarySkeletalMesh", "skeleton", "physicsAsset", "materialSlots", "textureBindings"]
    },
    "sourceGeometry": { "type": "object" },
    "readiness": { "type": "object" },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
